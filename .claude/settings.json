{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test-kit)",
      "Bash(make test-app)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make build-appstore)",
      "Bash(make check-appstore)",
      "Bash(xcodebuild -list *)",
      "Bash(swift test --package-path Packages/SurimonoKit)",
      "Bash(xcrun swift-format lint *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ]
  }
}
