  "strings": {
    "The text encoding could not be read without data loss.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を欠落させずに読み取れる文字コードを判定できませんでした。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text encoding could not be read without data loss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定能完整读取文本的字符编码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法判定能完整讀取文字的字元編碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 손실 없이 읽을 수 있는 텍스트 인코딩을 판별할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cet encodage sans perte de données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Textkodierung konnte nicht verlustfrei gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la codificación del texto sin perder datos."
          }
        }
      }
    },
