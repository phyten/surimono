{
  "sourceLanguage": "en",
  "strings": {
    "The text encoding could not be read without data loss.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字を欠落させずに読み取れる文字コードを判定できませんでした。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text encoding could not be read without data loss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在不丢失数据的情况下读取此文本编码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在不遺失資料的情況下讀取此文字編碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 손실 없이 텍스트 인코딩을 읽을 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cet encodage sans perte de données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Textkodierung konnte nicht verlustfrei gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la codificación del texto sin perder datos."
          }
        }
      }
    },
