          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷画面で綴じ方が変わりました。綴じ方を変えずに、もう一度両面のテスト印刷をしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
