    "The 3-up handout has a notes column of its own, so it takes no note pages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 3-up handout has a notes column of its own, so it takes no note pages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3枚＋メモのレイアウトにはメモ欄があるので、ノートページは入れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每页3张＋笔记已有笔记栏，不会加入笔记页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每頁3張＋筆記已有筆記欄，不會加入筆記頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3쪽 + 메모 레이아웃에는 메모란이 있어 노트 페이지를 넣지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format 3 pages + notes a sa propre colonne de notes et ne prend pas de pages de notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Layout 3 Seiten + Notizen hat eine eigene Notizspalte und nimmt keine Notizseiten auf."
