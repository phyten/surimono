    "With One Page, the window narrows to the cover while a spread shows it alone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With One Page, the window narrows to the cover while a spread shows it alone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Eine Seite“ wird das Fenster auf das Deckblatt verkleinert, solange eine Doppelseite es einzeln zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Una página», la ventana se estrecha a la portada mientras la doble página la muestra sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Une page », la fenêtre se réduit à la couverture tant que la double page l’affiche seule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「1ページ分」にすると、見開きで表紙を単独表示している間は、ウィンドウを表紙1ページ分の幅にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“한 페이지”로 하면 펼침 보기에서 표지를 단독으로 표시하는 동안 창을 표지 한 페이지 너비로 줄입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“一页”时，双页显示中单独显示封面期间，窗口会缩小为封面一页的宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「一頁」時，雙頁顯示中單獨顯示封面期間，視窗會縮小為封面一頁的寬度。"
          }
        }
      }
    },
