    "Use Command, Option, or Control and a different shortcut for each action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Command, Option, or Control and a different shortcut for each action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command・Option・Control のいずれかを含め、操作ごとに異なるショートカットを指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请包含 Command、Option 或 Control，并为每个操作使用不同的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請包含 Command、Option 或 Control，並為每個操作使用不同的快捷鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, Option 또는 Control을 포함하고 작업마다 다른 단축키를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Commande, Option ou Contrôle et un raccourci différent pour chaque action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Command, Option oder Control und für jede Aktion einen anderen Kurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Comando, Opción o Control y un atajo distinto para cada acción."
          }
        }
      }
    },
