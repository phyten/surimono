        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請嘗試橫向紙張或較小文字，或在原始文件中調整此部分。"
          }
        }
      }
    },
    "Check the formula's syntax and use supported commands in the source document.": {
