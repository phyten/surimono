    "Applies paper and layout, margins, headers and footers, finishing, notes, style and text size, and HTML presets in one step. View layout and zoom are not included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies paper and layout, margins, headers and footers, finishing, notes, style and text size, and HTML presets in one step. View layout and zoom are not included."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用紙とレイアウト・余白・ヘッダーとフッター・仕上げ・ノート・スタイルと文字の大きさ・HTML プリセットをまとめて当てます。1 枚・見開きと拡大率は含みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次应用纸张和布局、边距、页眉页脚、分页等处理、笔记页、样式和文字大小以及 HTML 预设。不包含视图布局和缩放比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次套用紙張與版面、邊界、頁首與頁尾、分頁等處理、筆記頁、樣式與文字大小及 HTML 預設。不包含檢視版面和縮放比例。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용지와 레이아웃, 여백, 머리말과 꼬리말, 마무리, 메모, 스타일과 글자 크기, HTML 프리셋을 한 번에 적용합니다. 보기 레이아웃과 확대 비율은 포함하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique en une fois le papier et la mise en page, les marges, les en-têtes et pieds de page, la finition, les notes, le style et la taille du texte, et les préréglages HTML. La disposition à l’écran et le zoom ne sont pas inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet Papier und Layout, Ränder, Kopf- und Fußzeilen, Verarbeitung, Notizen, Stil und Textgröße sowie HTML-Vorlagen in einem Schritt an. Ansichtslayout und Zoom sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica de una vez papel y diseño, márgenes, encabezados y pies, acabado, notas, estilo y tamaño del texto y preajustes HTML. No incluye el diseño de la vista ni el zoom."
          }
        }
      }
    },
    "None yet. Save one from Document › Setting Sets › Save Current Settings… or from Setting Sets on the print screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None yet. Save one from Document › Setting Sets › Save Current Settings… or from Setting Sets on the print screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません。メニューバーの「文書」→「設定セット」→「今の設定を保存…」か印刷画面の「設定セット」から保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无。可通过“文档”→“设置集”→“保存当前设置…”或打印界面中的“设置集”保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無。可透過「文件」→「設定集」→「儲存目前設定…」或列印畫面中的「設定集」儲存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없습니다. 문서 › 설정 세트 › 현재 설정 저장… 또는 인쇄 화면의 설정 세트에서 저장하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pour l’instant. Enregistrez-en un avec Document › Jeux de réglages › Enregistrer les réglages actuels… ou avec Jeux de réglages dans l’écran d’impression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine. Sichern Sie eines über Dokument › Einstellungssätze › Aktuelle Einstellungen sichern … oder über Einstellungssätze im Druckbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay. Guarda uno con Documento › Conjuntos de ajustes › Guardar ajustes actuales… o con Conjuntos de ajustes en la pantalla de impresión."
          }
        }
      }
    },
