    "Applies to text documents and images. PDFs keep their own margins.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの文書と画像に使います。PDF は元の余白のままです。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to text documents and images. PDFs keep their own margins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于文本文档和图像。PDF 保留自身页边距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於文字文件和影像。PDF 保留自身邊界。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 문서와 이미지에 적용됩니다. PDF는 원래 여백을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux textes et aux images. Les PDF conservent leurs marges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Textdokumente und Bilder. PDFs behalten ihre eigenen Ränder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a textos e imágenes. Los PDF conservan sus márgenes."
          }
        }
      }
    },
    "For printers that print back sides upside down, or when feeding the back sides by hand.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
