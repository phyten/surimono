    "Formats less than Standard. A note of headings, sentences and a list may stay unformatted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatiert weniger als „Standard“. Eine Notiz aus Überschriften, Sätzen und einer Liste bleibt eventuell unformatiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formats less than Standard. A note of headings, sentences and a list may stay unformatted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da formato a menos textos que «Estándar». Una nota con títulos, frases y una lista puede quedar sin formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en forme moins que « Standard ». Une note faite de titres, de phrases et d’une liste peut rester telle quelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準より控えめに整形します。見出しと文と箇条書きのメモは整形しないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘표준’보다 적게 정리합니다. 제목과 문장, 목록으로 된 메모는 정리하지 않을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理得比“标准”少。由标题、句子和列表组成的笔记可能不会整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理得比「標準」少。由標題、句子和清單組成的筆記可能不會整理。"
          }
        }
      }
    },
    "Usually also formats notes of headings, sentences and a list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatiert meist auch Notizen aus Überschriften, Sätzen und einer Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually also formats notes of headings, sentences and a list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente también da formato a notas con títulos, frases y una lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met aussi en forme la plupart des notes faites de titres, de phrases et d’une liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出しと文と箇条書きのメモもたいてい整形します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목과 문장, 목록으로 된 메모도 대개 정리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由标题、句子和列表组成的笔记通常也会整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由標題、句子和清單組成的筆記通常也會整理。"
          }
        }
      }
    },
    "May format even a heading with numbered steps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatiert unter Umständen schon eine Überschrift mit nummerierten Schritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May format even a heading with numbered steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede dar formato incluso a un título con pasos numerados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut mettre en forme même un titre suivi d’étapes numérotées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出しと番号付きの手順だけでも整形することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목과 번호 매긴 단계만 있어도 정리할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使只有标题和编号步骤，也可能会整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使只有標題和編號步驟，也可能會整理。"
          }
        }
      }
    },
