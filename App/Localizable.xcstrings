        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一個已儲存的排列無法讀取，已將其略去。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없는 저장된 배치가 있어 목록에서 뺐습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une disposition enregistrée était illisible et a été écartée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gesicherte Anordnung war unlesbar und wurde ausgelassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una disposición guardada no se pudo leer y se ha omitido."
          }
        }
      }
    },
    "Discard your changes and show the arrangement as it is saved now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard your changes and show the arrangement as it is saved now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄して、いま保存されている配置を表示します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃你的更改，显示当前已保存的排列"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄你的變更，顯示目前已儲存的排列"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 버리고 지금 저장된 배치를 표시합니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonne vos modifications et affiche la disposition telle qu’elle est enregistrée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwirft deine Änderungen und zeigt die Anordnung, wie sie jetzt gesichert ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta tus cambios y muestra la disposición tal como está guardada"
          }
        }
      }
    },
    "Not saved: this arrangement was changed elsewhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not saved: this arrangement was changed elsewhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しませんでした。この配置はほかの場所で変更されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存：此排列已在别处更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未儲存：此排列已在別處變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않았습니다. 이 배치는 다른 곳에서 바뀌었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré : cette disposition a été modifiée ailleurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gesichert: Diese Anordnung wurde anderswo geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado: esta disposición se cambió en otro sitio."
          }
        }
      }
    },
    "Some parts of a saved arrangement were out of place and were put back.": {
      "extractionState": "manual",
