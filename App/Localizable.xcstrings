    "Headings do not break the page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headings do not break the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出しでは改ページしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题不分页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題不分頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목에서 페이지를 나누지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres ne créent pas de saut de page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschriften erzeugen keinen Umbruch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos no saltan de página."
          }
        }
      }
    },
    "Breaks the page before the largest headings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks the page before the largest headings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番大きい見出しの前で改ページします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最大的标题前分页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最大的標題前分頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 제목 앞에서 페이지를 나눕니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut de page avant les plus grands titres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbruch vor den größten Überschriften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta de página antes de los títulos mayores."
          }
        }
      }
    },
