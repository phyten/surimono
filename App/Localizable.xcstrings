        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "束の順番を変えずにそのままトレイへ戻します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持纸叠顺序不变，将整叠纸放回纸盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持紙疊順序不變，將整疊紙放回紙匣。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용지 순서를 바꾸지 않고 묶음 그대로 용지함에 다시 넣습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettez la pile dans le bac sans changer l’ordre des feuilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie den Stapel in derselben Reihenfolge wieder in das Fach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a colocar la pila en la bandeja sin cambiar el orden."
          }
        }
      }
    },
    "Load the paper so the blank sides will be printed. Turn the whole stack if needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the paper so the blank sides will be printed. Turn the whole stack if needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白い面に印刷される向きで入れます。向きを変えるときは、束ごと動かします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空白面可被打印的方向放入纸张。如需调整方向，请转动整叠纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以空白面可被列印的方向放入紙張。如需調整方向，請轉動整疊紙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 면에 인쇄되도록 용지를 넣습니다. 방향을 바꿀 때는 묶음 전체를 돌립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le papier pour imprimer sur les faces vierges. Si nécessaire, tournez toute la pile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie das Papier so ein, dass die leeren Seiten bedruckt werden. Drehen Sie bei Bedarf den ganzen Stapel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargue el papel para imprimir en las caras en blanco. Si necesita girarlo, gire toda la pila."
          }
        }
      }
    },
