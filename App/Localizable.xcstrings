    "Save replaces “%@” with your changes. Discard keeps it as it was saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save replaces “%@” with your changes. Discard keeps it as it was saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると「%@」を今の変更で上書きします。破棄すると、保存してある内容のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存会用你的更改替换“%@”。放弃则保持已保存的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存會以你的變更取代「%@」。放棄則保持已儲存的內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 ‘%@’을(를) 지금의 변경 사항으로 바꿉니다. 버리면 저장된 그대로 둡니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer remplace « %@ » par vos modifications. Abandonner la garde telle qu’enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern ersetzt „%@“ durch deine Änderungen. Verwerfen lässt sie wie gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar sustituye «%@» por tus cambios. Descartar la deja como estaba guardada."
          }
        }
      }
    },
