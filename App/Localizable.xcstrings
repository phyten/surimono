    "Surimono never changes the original document; these keys stay disabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono never changes the original document; these keys stay disabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono は元の文書を変更しないため、保存のキーは無効のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 不会修改原文档；这些按键保持禁用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 不會修改原始文件；這些按鍵保持停用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono는 원본 문서를 변경하지 않으므로 이 키는 비활성 상태로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono ne modifie jamais l’original ; ces touches restent désactivées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono ändert das Original nie; diese Tasten bleiben deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono nunca modifica el original; estas teclas permanecen desactivadas."
          }
        }
      }
    },
    "System shortcuts or the keyboard layout could not be read. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System shortcuts or the keyboard layout could not be read. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのショートカットまたはキーボード配列を読み取れませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
