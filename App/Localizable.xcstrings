    },
    "The new language takes effect after relaunch. Open windows will close; you may need to reopen your documents. Choose Later to keep working." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい言語は再起動後に反映されます。開いているウィンドウは閉じるため、文書を開き直す必要がある場合があります。作業を続けるには「あとで」を選んでください。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new language takes effect after relaunch. Open windows will close; you may need to reopen your documents. Choose Later to keep working."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新语言将在重新启动后生效。打开的窗口将关闭，您可能需要重新打开文档。选择“稍后”以继续工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新語言將在重新啟動後生效。打開的視窗將關閉，您可能需要重新打開文件。選擇「稍後」以繼續工作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 언어는 다시 실행한 후 적용됩니다. 열린 윈도우가 닫히며 문서를 다시 열어야 할 수 있습니다. 계속 작업하려면 ‘나중에’를 선택하세요."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle langue s’appliquera après la relance. Les fenêtres ouvertes seront fermées ; vous devrez peut-être rouvrir vos documents. Choisissez « Plus tard » pour continuer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Sprache gilt nach dem Neustart. Offene Fenster werden geschlossen; möglicherweise müssen Sie Dokumente erneut öffnen. Wählen Sie „Später“, um weiterzuarbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo idioma se aplicará al reabrir. Las ventanas se cerrarán; puede que tengas que volver a abrir tus documentos. Elige «Más tarde» para seguir trabajando."
          }
        }
      }
    },
