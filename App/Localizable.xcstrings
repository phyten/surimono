    "Paper keys work when the paper has focus. A toolbar set to always show stays visible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paper keys work when the paper has focus. A toolbar set to always show stays visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙にフォーカスがあるときにキーが効きます。「常に表示」のツールバーは隠れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸张获得焦点时按键才有效。设为“始终显示”的工具栏不会隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紙張取得焦點時按鍵才有效。設為「永遠顯示」的工具列不會隱藏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용지에 포커스가 있을 때 키가 동작합니다. ‘항상 표시’로 설정한 도구 막대는 숨겨지지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches agissent quand le papier a le focus. Une barre d’outils réglée sur Toujours reste visible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten wirken, wenn das Papier den Fokus hat. Eine auf „Immer“ gestellte Symbolleiste bleibt sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas funcionan cuando el papel tiene el foco. Una barra en «Siempre» sigue visible."
          }
        }
      }
    },
