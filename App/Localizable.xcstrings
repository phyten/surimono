    "Encrypted PDFs cannot be printed. Open an unlocked copy.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された PDF は印刷できません。ロックを解除したコピーを開いてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted PDFs cannot be printed. Open an unlocked copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打印加密的 PDF。请打开未加密的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法列印加密的 PDF。請打開未加密的副本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 PDF는 프린트할 수 없습니다. 잠금 해제된 사본을 여세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les PDF chiffrés ne peuvent pas être imprimés. Ouvrez une copie déverrouillée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte PDFs können nicht gedruckt werden. Öffnen Sie eine entsperrte Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden imprimir PDF cifrados. Abre una copia desbloqueada."
          }
        }
      }
    },
    "The text encoding could not be read without data loss.": {
      "extractionState": "manual",
      "localizations": {
