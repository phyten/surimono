    "Adds %lld note pages after the chapters, or after the last page without chapters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds %lld note pages after the chapters, or after the last page without chapters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "章の終わりに、ノートを %lld ページ追加します（章がなければ最後に）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在章末添加 %lld 页笔记（没有章节时加在最后）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在章末加入 %lld 頁筆記（沒有章節時加在最後）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장 끝에 노트 %lld쪽을 넣습니다(장이 없으면 맨 끝에)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute %lld pages de notes après les chapitres, ou à la fin s’il n’y en a pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt %lld Notizseiten nach den Kapiteln hinzu, ohne Kapitel am Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade %lld páginas de notas tras los capítulos, o al final si no los hay."
          }
        }
      }
    },
    "One-sided: adds %lld note pages on sheets of their own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-sided: adds %lld note pages on sheets of their own."
