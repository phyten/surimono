    "I understand that global keys work in other apps and printing keys can send pages to a printer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that global keys work in other apps and printing keys can send pages to a printer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルキーはほかのアプリでも働き、印刷キーはプリンターに送信することを確認しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解全局按键在其他应用中也生效，打印按键可能将页面发送到打印机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解全域按鍵在其他 App 中也生效，列印按鍵可能將頁面傳送至印表機。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 키는 다른 앱에서도 작동하며 인쇄 키는 프린터로 페이지를 보낼 수 있음을 이해합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que les touches globales fonctionnent dans d’autres apps et que les touches d’impression peuvent envoyer des pages à une imprimante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass globale Tasten in anderen Apps wirken und Drucktasten Seiten an einen Drucker senden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que las teclas globales funcionan en otras apps y las de impresión pueden enviar páginas a una impresora."
          }
        }
      }
    },
    "This operation cannot be changed in this build or is managed by macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation cannot be changed in this build or is managed by macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この版では変更できない操作か、macOS が管理する割り当てです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法更改该操作，或其分配由 macOS 管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本無法變更該操作，或其配置由 macOS 管理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서 변경할 수 없거나 macOS에서 관리하는 작업입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération ne peut pas être modifiée dans cette version ou est gérée par macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorgang kann in dieser Version nicht geändert werden oder wird von macOS verwaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operación no se puede cambiar en esta versión o la gestiona macOS."
          }
        }
      }
    },
    "This shortcut file uses an unsupported version. Update Surimono to import it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut file uses an unsupported version. Update Surimono to import it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットファイルの形式の版には対応していません。Surimono をアップデートして読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此快捷键文件的版本。请更新 Surimono 后导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此快捷鍵檔案的版本。請更新 Surimono 後匯入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않는 단축키 파일 버전입니다. Surimono를 업데이트한 후 가져오세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de ce fichier de raccourcis n’est pas prise en charge. Mettez Surimono à jour pour l’importer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kurzbefehldatei hat eine nicht unterstützte Version. Aktualisiere Surimono, um sie zu importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de este archivo de atajos no es compatible. Actualiza Surimono para importarlo."
          }
        }
      }
    },
    "This shortcut file is invalid or exceeds the import limits. Nothing was changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut file is invalid or exceeds the import limits. Nothing was changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットファイルの形式が正しくないか、読み込みの上限を超えています。変更はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键文件无效或超出导入限制。未作任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷鍵檔案無效或超出匯入限制。未做任何變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 파일이 잘못되었거나 가져오기 한도를 초과했습니다. 변경된 내용은 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier de raccourcis est invalide ou dépasse les limites d’importation. Rien n’a été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
