    "Word documents must fit within 50 MB compressed and 300 MB expanded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word documents must fit within 50 MB compressed and 300 MB expanded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 文書は圧縮時 50 MB、展開時 300 MB まで開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 文档压缩后不得超过 50 MB，解压后不得超过 300 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 文件壓縮後不可超過 50 MB，解壓縮後不可超過 300 MB。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Word 문서는 압축 시 50 MB, 압축 해제 시 300 MB 이하여야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille du document Word est limitée à 50 Mo compressé et 300 Mo décompressé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Word-Dokumente dürfen komprimiert höchstens 50 MB und entpackt höchstens 300 MB groß sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento de Word puede ocupar hasta 50 MB comprimido y 300 MB descomprimido."
          }
        }
      }
    },
