    "An open book changes the everyday view.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open book changes the everyday view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本をひらくと、いつもの景色が少し変わります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aufgeschlagenes Buch verändert den Blick auf den Alltag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir un libro cambia nuestra forma de ver lo cotidiano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un livre change le regard que l’on porte sur le quotidien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 펼치면 평소의 풍경이 조금 달라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻开一本书，眼前的日常景色就有了些许变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻開一本書，眼前的日常景色就有了些許變化。"
          }
        }
      }
    },
    "Keep a few words on paper, then look for the next book on the shelf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a few words on paper, then look for the next book on the shelf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心に残った言葉をメモして、次に読む本を棚から探します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir schreiben ein paar Worte auf und suchen im Regal nach dem nächsten Buch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotamos unas palabras y buscamos en el estante el próximo libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On note quelques mots sur le papier, puis on cherche le prochain livre sur l’étagère."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 남은 말을 적어 두고 책장에서 다음에 읽을 책을 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
