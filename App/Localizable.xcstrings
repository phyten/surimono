    "Cancelling does not cancel print jobs already sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelling does not cancel print jobs already sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしても、送った印刷は取り消されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消不会撤回已发送的打印任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消不會撤回已傳送的列印工作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소해도 이미 보낸 인쇄 작업은 취소되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation ne supprime pas les impressions déjà envoyées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gesendete Druckaufträge werden durch Abbrechen nicht zurückgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar no anula los trabajos de impresión ya enviados."
          }
        }
      }
    },
    "%@ is unavailable. Connect the printer, then press Print the Backs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unavailable. Connect the printer, then press Print the Backs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が見つかりません。プリンターをつないでから「裏を印刷」を押してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@。请连接打印机，然后点按“打印背面”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@。請連接印表機，然後按下「列印背面」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 찾을 수 없습니다. 프린터를 연결한 후 뒷면 인쇄를 누르세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est introuvable. Connectez l’imprimante, puis cliquez sur Imprimer les versos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht verfügbar. Verbinden Sie den Drucker und klicken Sie auf Rückseiten drucken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra %@. Conecte la impresora y pulse Imprimir los reversos."
          }
        }
      }
    },
    "The backs could not be prepared. Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backs could not be prepared. Nothing was sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "裏を準備できませんでした。何も送っていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备背面。未发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備背面。未傳送任何內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒷면을 준비하지 못했습니다. 아무것도 보내지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer les versos. Rien n’a été envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rückseiten konnten nicht vorbereitet werden. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar los reversos. No se ha enviado nada."
          }
        }
      }
    },
    "The print job could not be sent or was cancelled. Check the print queue and paper before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The print job could not be sent or was cancelled. Check the print queue and paper before trying again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷を送れなかったか、取り消されました。プリンターの待ち行列と用紙を確かめてから、やり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打印任务无法发送或已取消。请检查打印队列和纸张，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列印工作無法傳送或已取消。請檢查列印佇列和紙張，然後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인쇄 작업을 보내지 못했거나 취소되었습니다. 인쇄 대기열과 용지를 확인한 후 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impression n’a pas pu être envoyée ou a été annulée. Vérifiez la file d’attente et le papier avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Druckauftrag konnte nicht gesendet werden oder wurde abgebrochen. Prüfen Sie die Warteschlange und das Papier, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el trabajo de impresión o se canceló. Revise la cola de impresión y el papel antes de volver a intentarlo."
          }
        }
      }
    },
