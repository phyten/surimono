    "Operations missing from the file keep their current keys. Nothing changes until you apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations missing from the file keep their current keys. Nothing changes until you apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルにない操作の割り当てはそのまま残します。「適用」までは何も変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件中未包含的操作保留现有按键。应用前不会更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案中未包含的操作保留現有按鍵。套用前不會變更任何內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 없는 작업은 현재 키를 유지합니다. 적용하기 전에는 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations absentes du fichier conservent leurs touches. Rien ne change avant l’application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht enthaltene Vorgänge behalten ihre Tasten. Erst beim Anwenden wird etwas geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones que no estén en el archivo conservan sus teclas. Nada cambia hasta que apliques los cambios."
          }
        }
      }
    },
