    "Remembered for %@. Last Sheet First keeps face-up sheets in page order.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for %@. Last Sheet First keeps face-up sheets in page order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の設定として覚えます。印刷面を上にして出すプリンターは「後ろの紙から」でページ順に重なります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für %@ gespeichert. „Letztes Blatt zuerst“ hält mit der Druckseite nach oben ausgegebene Blätter in Seitenreihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda para %@. «Última hoja primero» mantiene en orden las hojas que salen boca arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé pour %@. « Dernière feuille d’abord » garde dans l’ordre les feuilles qui sortent face imprimée vers le haut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 설정으로 기억합니다. 인쇄면이 위로 나오는 프린터는 «마지막 용지부터»로 페이지 순서를 맞춥니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住 %@ 的设置。“从最后一张开始”可让打印面朝上输出的纸张按页码堆叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住 %@ 的設定。「從最後一張開始」可讓列印面朝上輸出的紙張按頁碼堆疊。"
          }
        }
      }
    },
    "Remembered for %@ with long-edge binding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for %@ with long-edge binding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で、長辺とじのときの設定として覚えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für %@ bei Bindung an der langen Kante gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda para %@ con encuadernación por el borde largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé pour %@ avec une reliure sur le bord long."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 긴 쪽 제본을 사용할 때의 설정으로 기억합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住 %@ 使用长边装订时的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住 %@ 使用長邊裝訂時的設定。"
          }
        }
      }
    },
