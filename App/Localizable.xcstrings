    "Standard cannot be overwritten. Duplicate it to keep your changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard cannot be overwritten. Duplicate it to keep your changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「標準」は上書きできません。変更を残すには複製してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准排列不能覆盖。请复制后保留更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準排列不能覆寫。請複製後保留變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준은 덮어쓸 수 없습니다. 변경 사항을 남기려면 복제하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le standard ne peut pas être écrasé. Dupliquez-le pour garder vos modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard lässt sich nicht überschreiben. Dupliziere es, um deine Änderungen zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estándar no se puede sobrescribir. Duplícala para conservar tus cambios."
          }
        }
      }
    },
    "Standard does not change. Save keeps your changes as a new arrangement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard does not change. Save keeps your changes as a new arrangement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「標準」は変わりません。保存すると、変更を新しい配置として残します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准排列不会改变。保存会将更改存为新排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準排列不會改變。儲存會將變更存為新排列。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준은 바뀌지 않습니다. 저장하면 변경 사항을 새 배치로 남깁니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le standard ne change pas. Enregistrer conserve vos modifications comme nouvelle disposition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard ändert sich nicht. Sichern behält deine Änderungen als neue Anordnung."
