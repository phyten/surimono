    "The menu has its own room outside the paper, so it never covers the paper.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu has its own room outside the paper, so it never covers the paper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューは紙の外に場所を取るので、紙に重なりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单在纸张之外占有自己的位置，不会遮住纸张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單在紙張之外佔有自己的位置，不會遮住紙張。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴는 용지 밖에 자리를 차지하므로 용지를 가리지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu a sa propre place hors du papier et ne le recouvre jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Menü hat seinen eigenen Platz außerhalb des Papiers und verdeckt es nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El menú tiene su propio espacio fuera del papel y nunca lo cubre."
          }
        }
      }
    },
