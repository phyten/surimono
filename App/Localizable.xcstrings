        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集している間に、この配置がほかの場所で変更されました。変更は「複製…」で新しい配置として残せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑期间，此排列已在别处更改。用“复制…”可将你的更改保存为新排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你編輯期間，此排列已在別處變更。用「複製…」可將你的變更儲存為新排列。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집하는 동안 이 배치가 다른 곳에서 바뀌었습니다. ‘복제…’로 변경 사항을 새 배치로 남길 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette disposition a été modifiée ailleurs pendant votre modification. Dupliquer conserve vos modifications comme nouvelle disposition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anordnung wurde anderswo geändert, während du sie bearbeitet hast. Duplizieren behält deine Änderungen als neue Anordnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta disposición se cambió en otro sitio mientras la editabas. Duplicar conserva tus cambios como una nueva disposición."
          }
        }
      }
    },
    "This arrangement was changed elsewhere. Save keeps your changes as a new arrangement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This arrangement was changed elsewhere. Save keeps your changes as a new arrangement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この配置はほかの場所で変更されています。保存すると、変更を新しい配置として残します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此排列已在别处更改。保存会将你的更改存为新排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此排列已在別處變更。儲存會將你的變更存為新排列。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배치는 다른 곳에서 바뀌었습니다. 저장하면 변경 사항을 새 배치로 남깁니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette disposition a été modifiée ailleurs. Enregistrer conserve vos modifications comme nouvelle disposition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anordnung wurde anderswo geändert. Sichern behält deine Änderungen als neue Anordnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta disposición se cambió en otro sitio. Guardar conserva tus cambios como una nueva disposición."
          }
        }
      }
    },
    "This step cannot be undone: the saved arrangements were changed elsewhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step cannot be undone: the saved arrangements were changed elsewhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。保存してある配置がほかの場所で変更されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销此步骤：已保存的排列已在别处更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法還原此步驟：已儲存的排列已在別處變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단계는 실행 취소할 수 없습니다. 저장된 배치가 다른 곳에서 바뀌었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette étape ne peut pas être annulée : les dispositions enregistrées ont été modifiées ailleurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schritt lässt sich nicht widerrufen: Die gesicherten Anordnungen wurden anderswo geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paso no se puede deshacer: las disposiciones guardadas se cambiaron en otro sitio."
          }
        }
      }
    },
