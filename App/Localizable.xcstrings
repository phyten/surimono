    },
    "Display zoom. The printed size does not change. Click to fit the sheets to the window.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示倍率です。刷る大きさは変わりません。クリックで用紙をウインドウに合わせます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display zoom. The printed size does not change. Click to fit the sheets to the window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示比例。打印尺寸不变。点按可使纸张适合窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示比例。列印尺寸不變。按一下可讓紙張配合視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 배율입니다. 인쇄 크기는 바뀌지 않습니다. 클릭하면 용지를 창에 맞춥니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom d’affichage. La taille d’impression ne change pas. Cliquez pour ajuster les feuilles à la fenêtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigegröße. Die Druckgröße ändert sich nicht. Klicken, um die Blätter ans Fenster anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom de la vista. El tamaño de impresión no cambia. Haz clic para ajustar las hojas a la ventana."
          }
        }
      }
    },
