    "Shortcut settings could not be saved. Reopen this page and try again; existing data is preserved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut settings could not be saved. Reopen this page and try again; existing data is preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット設定を保存できませんでした。このページを開き直してお試しください。既存のデータは保持しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存快捷键设置。请重新打开此页面后重试；现有数据已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
