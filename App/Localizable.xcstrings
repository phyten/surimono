    "The toolbar has its own room outside the paper, so it never covers the paper.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The toolbar has its own room outside the paper, so it never covers the paper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーは紙の外に場所を取るので、紙に重なりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏位于纸张之外，不会遮住纸张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列位於紙張之外，不會遮住紙張。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대는 용지 바깥에 자리를 잡으므로 용지를 가리지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d’outils a sa place hors du papier et ne le couvre jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbolleiste hat ihren Platz außerhalb des Papiers und verdeckt es nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra tiene su sitio fuera del papel y nunca lo cubre."
          }
        }
      }
