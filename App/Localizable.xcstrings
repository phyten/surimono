    "The arrangement on screen, unsaved changes included, is saved under this name and used in all view windows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arrangement on screen, unsaved changes included, is saved under this name and used in all view windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の配置を、未保存の変更も含めてこの名前で保存し、すべての表示画面で使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上的排列（含未保存的更改）将以此名称保存，并用于所有查看窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面上的排列（含未儲存的變更）將以此名稱儲存，並用於所有檢視視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 배치를 저장되지 않은 변경 사항까지 포함해 이 이름으로 저장하고 모든 보기 창에서 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition affichée, modifications non enregistrées comprises, est enregistrée sous ce nom et utilisée dans toutes les fenêtres d’affichage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angezeigte Anordnung wird samt ungesicherten Änderungen unter diesem Namen gesichert und in allen Ansichtsfenstern verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposición en pantalla, con los cambios sin guardar, se guarda con este nombre y se usa en todas las ventanas de vista."
          }
        }
      }
    },
    "The saved toolbar arrangements could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved toolbar arrangements could not be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存してあるツールバーの配置を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的工具栏排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的工具列排列。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 도구 막대 배치를 읽을 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dispositions enregistrées de la barre d’outils n’ont pas pu être lues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesicherten Anordnungen der Symbolleiste konnten nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las disposiciones guardadas de la barra de herramientas."
          }
        }
      }
    },
    "The toolbar uses Standard for now, and nothing is saved. Starting over keeps the unreadable data aside instead of deleting it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The toolbar uses Standard for now, and nothing is saved. Starting over keeps the unreadable data aside instead of deleting it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまは標準の配置を使っていて、何も保存しません。「標準から始め直す」を押しても、読めなかったデータは消さずに別の場所に残します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏暂时使用标准排列，且不会保存任何内容。重新开始会把无法读取的数据另行保留，而不是删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列暫時使用標準排列，且不會儲存任何內容。重新開始會把無法讀取的資料另行保留，而不是刪除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 도구 막대가 표준을 사용하며 아무것도 저장하지 않습니다. 다시 시작해도 읽지 못한 데이터는 지우지 않고 따로 보관합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d’outils utilise le standard pour l’instant et rien n’est enregistré. Recommencer met les données illisibles de côté au lieu de les supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbolleiste verwendet vorerst Standard, und nichts wird gesichert. Neu beginnen legt die unlesbaren Daten beiseite, statt sie zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora la barra de herramientas usa la estándar y no se guarda nada. Empezar de nuevo aparta los datos ilegibles en lugar de borrarlos."
          }
        }
      }
    },
    "The unsaved changes are discarded with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The unsaved changes are discarded with it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存の変更も一緒に破棄されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存的更改也会一并放弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未儲存的變更也會一併放棄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 변경 사항도 함께 버려집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications non enregistrées sont abandonnées avec elle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ungesicherten Änderungen werden mit verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios sin guardar se descartan con ella."
          }
        }
      }
    },
    "This arrangement is in use. Choose the one all view windows use instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This arrangement is in use. Choose the one all view windows use instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この配置は使用中です。代わりにすべての表示画面で使う配置を選んでください。"
