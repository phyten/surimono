    "Relaunch to Change Language?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を変えて再起動しますか？"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaunch to Change Language?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新启动以更改语言？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動以更改語言？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 변경하려면 다시 실행할까요?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relancer pour changer de langue ?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Ändern der Sprache neu starten?"
          }
        },
