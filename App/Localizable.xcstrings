          "stringUnit": {
            "state": "translated",
            "value": "Die Ränder sind für diese Seite zu groß. Ändern Sie sie in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los márgenes son demasiado grandes para esta página. Cámbialos en Ajustes."
