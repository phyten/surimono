    "%lld diagrams were not drawn in time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld diagrams were not drawn in time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に描画できなかった図が %lld 個あります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Diagramme konnten nicht rechtzeitig gezeichnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron dibujar %lld diagramas a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld diagrammes n’ont pas pu être dessinés à temps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 안에 그리지 못한 다이어그램이 %lld개 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个图未能及时绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個圖未能及時繪製。"
          }
        }
      }
    },
