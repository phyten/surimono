          }
        }
      }
    },
    "Initial values for printers without remembered settings. Last Sheet First keeps face-up sheets in page order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initial values for printers without remembered settings. Last Sheet First keeps face-up sheets in page order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を覚えていないプリンターの初期値です。印刷面を上にして出すプリンターは「最後の用紙から」でページ順に重なります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于尚未记住设置的打印机。面朝上出纸时，“从最后一张开始”可按页序叠放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於尚未記住設定的印表機。面朝上出紙時，「從最後一張開始」可按頁序疊放。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 기억하지 않은 프린터의 초기값입니다. 인쇄면이 위로 나오는 프린터는 ‘마지막 용지부터’로 페이지 순서대로 쌓입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs initiales des imprimantes sans réglages mémorisés. Dernière feuille d’abord garde l’ordre des pages pour une sortie face vers le haut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfangswerte für Drucker ohne gemerkte Einstellungen. Letztes Blatt zuerst hält Blätter mit der Schrift nach oben in Seitenreihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores iniciales para impresoras sin ajustes guardados. Última hoja primero mantiene el orden con salida boca arriba."
          }
        }
      }
    },
