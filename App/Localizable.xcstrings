    "Paper keys work when the paper has focus. A menu band set to always show stays visible.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paper keys work when the paper has focus. A menu band set to always show stays visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙にフォーカスがあるときにキーが効きます。「常に出す」にした帯は隠れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸张获得焦点时，纸张快捷键才有效。设为始终显示的菜单栏不会隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紙張取得焦點時，紙張快捷鍵才有效。設為永遠顯示的選單帶不會隱藏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용지에 포커스가 있을 때 용지 키가 작동합니다. 항상 표시로 설정한 메뉴 띠는 숨겨지지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches du papier fonctionnent lorsque le papier a le focus. Un bandeau réglé sur Toujours reste visible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papiertasten funktionieren, wenn das Papier den Fokus hat. Eine immer eingeblendete Menüleiste bleibt sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas del papel funcionan cuando el papel tiene el foco. Una banda de menú configurada para mostrarse siempre permanece visible."
          }
        }
      }
    },
