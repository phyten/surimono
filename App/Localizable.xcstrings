    "This shortcut works from other apps while Surimono is running. It never prints directly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut works from other apps while Surimono is running. It never prints directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono の起動中は、ほかのアプリからも使えます。このキーだけで直接印刷することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 运行时可在其他应用中使用此快捷键。它不会直接打印。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 執行時可在其他應用程式中使用此快速鍵。它不會直接列印。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 실행 중에는 다른 앱에서도 사용할 수 있습니다. 이 키로 직접 인쇄하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci fonctionne depuis les autres apps lorsque Surimono est ouvert. Il n’imprime jamais directement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kurzbefehl funktioniert in anderen Apps, solange Surimono läuft. Er druckt niemals direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atajo funciona desde otras apps mientras Surimono está abierto. Nunca imprime directamente."
          }
        }
      }
    },
