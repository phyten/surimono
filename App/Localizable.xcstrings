    },
    "A layout of a saved arrangement could not be read and is back to Standard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A layout of a saved arrangement could not be read and is back to Standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した配置の組み方の一つを読めなかったため、標準に戻しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取某个已保存排列中的一种布局，已恢复为标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取某個已儲存排列中的一種版面，已回復為標準。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 배치의 구성 하나를 읽을 수 없어 표준으로 되돌렸습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une variante d’une disposition enregistrée était illisible et revient au standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Variante einer gesicherten Anordnung war unlesbar und ist wieder Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una variante de una disposición guardada no se pudo leer y vuelve a ser la estándar."
          }
        }
      }
    },
    "A saved arrangement could not be read and was left out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved arrangement could not be read and was left out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読めなかった配置セットがあり、一覧から外しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
