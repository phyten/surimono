    "New documents start with these margins, header and footer, page breaks and contents": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New documents start with these margins, header and footer, page breaks and contents. Note pages are not included."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい文書を、この余白・ヘッダー / フッター・改ページ・目次で始めます。ノートページは含みません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新文档将使用这些边距、页眉 / 页脚、分页和目录。不包括笔记页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件將使用這些邊界、頁首 / 頁尾、分頁和目錄。不包括筆記頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 문서를 이 여백, 머리글 / 바닥글, 페이지 나누기, 목차로 시작합니다. 노트 페이지는 포함되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux documents commencent avec ces marges, en-tête et pied de page, sauts de page et sommaire. Les pages de notes ne sont pas incluses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Dokumente beginnen mit diesen Rändern, Kopf- und Fußzeilen, Seitenumbrüchen und diesem Inhalt. Notizseiten gehören nicht dazu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos nuevos empiezan con estos márgenes, encabezado y pie, saltos de página e índice. No incluye las páginas de notas."
          }
        }
      }
    },
