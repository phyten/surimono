    "Print on **both sides of %1$@ landscape** (short-edge binding). Stack the sheets with sheet 1 outermost, fold them in the middle and staple twice along the fold to get the **%2$@ booklet**.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%1$@ 横の両面**に刷り（短辺綴じ）、1 枚目が外側になるように重ねて中央で折り、折り目を 2 か所ホチキスで留めると **%2$@ 冊子**になります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print on **both sides of %1$@ landscape** (short-edge binding). Stack the sheets with sheet 1 outermost, fold them in the middle and staple twice along the fold to get the **%2$@ booklet**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%1$@ 横向纸张上双面打印**（短边装订）。将第 1 张放在最外侧叠好，居中对折，沿折痕装订两次，即可制成 **%2$@ 小册子**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%1$@ 橫向紙張上雙面列印**（短邊裝訂）。將第 1 張放在最外側疊好，居中對折，沿折痕裝訂兩次，即可製成 **%2$@ 小冊子**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%1$@ 가로 용지 양면**에 프린트합니다(짧은 가장자리 제본). 1번 용지를 가장 바깥에 놓고 쌓아 가운데를 접은 뒤 접힌 선을 따라 두 번 철하면 **%2$@ 소책자**가 됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimez en **recto verso sur du %1$@ paysage** (reliure bord court). Empilez les feuilles, la feuille 1 à l’extérieur, pliez au milieu et agrafez deux fois le pli pour obtenir un **livret %2$@**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Beidseitig auf %1$@ im Querformat** drucken (kurze Kante). Blatt 1 außen auf den Stapel legen, mittig falten und zweimal am Falz heften: So entsteht die **%2$@-Broschüre**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime por **ambas caras en %1$@ horizontal** (borde corto). Apila las hojas con la hoja 1 por fuera, dóblalas por la mitad y grapa dos veces el pliegue para obtener el **folleto %2$@**."
          }
        }
      }
    },
    "Prints **two pages side by side on %@ landscape**, single-sided. No folding.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 横に 2 ページずつ**並べて、片面で刷ります。折りません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints **two pages side by side on %@ landscape**, single-sided. No folding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 横向纸张上并排打印两页**，单面，无需折叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 橫向紙張上並排列印兩頁**，單面，無須折疊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 가로 용지에 두 페이지를 나란히** 단면으로 프린트합니다. 접지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **deux pages côte à côte sur du %@ paysage**, en recto. Sans pliage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt **zwei Seiten nebeneinander auf %@ quer**, einseitig. Ohne Falten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **dos páginas juntas en %@ horizontal**, a una cara. Sin plegar."
          }
        }
      }
    },
    "Prints **one page per %@ portrait sheet**, single-sided.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 縦に 1 ページずつ**、片面で刷ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints **one page per %@ portrait sheet**, single-sided."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 纵向纸张上每张打印一页**，单面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 直向紙張上每張列印一頁**，單面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 세로 용지 한 장에 한 페이지씩** 단면으로 프린트합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **une page par feuille %@ portrait**, en recto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt **eine Seite pro Blatt %@ hoch**, einseitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **una página por hoja %@ vertical**, a una cara."
          }
        }
      }
    },
    "Prints on **both sides of %@** (long-edge binding). Back sides turn like the pages of a book.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ の両面**に刷ります（長辺綴じ）。裏面は本のページをめくる向きです。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints on **both sides of %@** (long-edge binding). Back sides turn like the pages of a book."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 纸张上双面打印**（长边装订）。背面像书页一样翻转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 紙張上雙面列印**（長邊裝訂）。背面像書頁一樣翻轉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 양면**에 프린트합니다(긴 가장자리 제본). 책처럼 넘겨 뒷면을 봅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime en **recto verso sur du %@** (reliure bord long). Les versos se tournent comme les pages d’un livre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt **beidseitig auf %@** (lange Kante). Rückseiten werden wie Buchseiten umgeblättert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime por **ambas caras en %@** (borde largo). Los reversos se pasan como las páginas de un libro."
          }
        }
      }
    },
