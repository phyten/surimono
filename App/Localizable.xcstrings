    "Each LaTeX document uses its class style until you choose a style for it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each LaTeX document uses its class style until you choose a style for it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX 文書では、その文書のスタイルを選ぶまでは文書クラスに合ったスタイルを使います。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX-Dokumente verwenden den Stil ihrer Dokumentklasse, bis Sie für das jeweilige Dokument einen Stil auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos LaTeX usan el estilo de su clase hasta que elijas un estilo para ese documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque document LaTeX utilise le style de sa classe jusqu’à ce que vous lui choisissiez un style."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX 문서는 해당 문서의 스타일을 직접 선택할 때까지 문서 클래스에 맞는 스타일을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX 文档使用文档类对应的样式，直到你为该文档选择其他样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX 文件會使用文件類別對應的樣式，直到你為該文件選擇其他樣式。"
          }
        }
      }
    },
