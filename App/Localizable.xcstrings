    "The saved setting set will be replaced with the current settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved setting set will be replaced with the current settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した設定セットを、今の設定で上書きします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Einstellungssatz wird durch die aktuellen Einstellungen ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El conjunto guardado se reemplazará con los ajustes actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu enregistré sera remplacé par les réglages actuels."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 설정 세트를 현재 설정으로 덮어씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的设置集将被当前设置覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將以目前設定覆寫已儲存的設定集。"
          }
        }
      }
    },
    "No setting sets yet. Save the current settings from a document’s Setting Sets menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No setting sets yet. Save the current settings from a document’s Setting Sets menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定セットはまだありません。文書の「設定セット」メニューから、今の設定を保存できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einstellungssätze. Sichere die aktuellen Einstellungen im Menü „Einstellungssätze“ eines Dokuments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay conjuntos de ajustes. Guarda los ajustes actuales desde el menú Conjuntos de ajustes de un documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeu de réglages. Enregistrez les réglages actuels depuis le menu Jeux de réglages d’un document."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 설정 세트가 없습니다. 문서의 설정 세트 메뉴에서 현재 설정을 저장할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无设置集。可从文档的“设置集”菜单保存当前设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無設定集。可從文件的「設定集」選單儲存目前設定。"
          }
        }
      }
    },
