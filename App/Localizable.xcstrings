        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역으로 끌거나, 부품을 선택하고 누르면 그 뒤에 구분선을 추가합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
