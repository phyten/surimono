    "Local shortcuts return to their defaults. Global shortcuts become unassigned. macOS assignments stay unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local shortcuts return to their defaults. Global shortcuts become unassigned. macOS assignments stay unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内のキーを既定に戻し、グローバルキーの割り当てを解除します。macOS の割り当ては変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内快捷键恢复默认，全局快捷键取消分配。macOS 分配保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內快捷鍵回復預設值，全域快捷鍵取消配置。macOS 配置保持不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내 단축키는 기본값으로 돌아가고 전역 단축키는 해제됩니다. macOS 할당은 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis locaux retrouvent leurs valeurs par défaut. Les raccourcis globaux sont désaffectés. Les affectations macOS restent inchangées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Kurzbefehle werden zurückgesetzt, globale Kurzbefehle aufgehoben. macOS-Zuweisungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
