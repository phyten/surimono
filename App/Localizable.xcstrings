    "Prints **two pages stacked on %@ portrait**, single-sided. No folding.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 縦に2ページを上下に並べて**、片面で印刷します。折らずに使います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints **two pages stacked on %@ portrait**, single-sided. No folding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 纵向纸张上上下打印两页**，单面，无需折叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 直向紙張上上下列印兩頁**，單面，無須摺疊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 세로 용지에 두 페이지를 위아래로** 단면 프린트합니다. 접지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **deux pages superposées sur du %@ portrait**, en recto. Sans pliage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt **zwei Seiten übereinander auf %@ hoch**, einseitig. Ohne Falten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **dos páginas apiladas en %@ vertical**, a una cara. Sin plegar."
          }
        }
      }
    },
    "Prints **one page per %@ landscape sheet**, single-sided.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 横の用紙1枚に1ページずつ**、片面で印刷します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints **one page per %@ landscape sheet**, single-sided."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 横向纸张上每张打印一页**，单面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 橫向紙張上每張列印一頁**，單面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 가로 용지 한 장에 한 페이지씩** 단면 프린트합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **une page par feuille %@ paysage**, en recto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt **eine Seite pro Blatt %@ quer**, einseitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **una página por hoja %@ horizontal**, a una cara."
          }
        }
      }
    },
