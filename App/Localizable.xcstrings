          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les raccourcis système ou la disposition du clavier. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemkurzbefehle oder Tastaturbelegung konnten nicht gelesen werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los atajos del sistema o la distribución del teclado. Inténtalo de nuevo."
          }
        }
      }
    },
