            "value": "按原样打印，不应用打印样式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依原樣列印，不套用列印樣式"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린트 스타일 없이 원본대로 프린트"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impression telle quelle, sans style"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unveränderter Druck ohne Druckstil"
          }
        },
        "es": {
