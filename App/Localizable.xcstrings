    "Surimono asks GitHub whether a newer version exists. Nothing about your documents is sent.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub に新しい版があるかを確かめます。文書についての情報は送りません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono asks GitHub whether a newer version exists. Nothing about your documents is sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 会向 GitHub 查询是否有新版本，不会发送任何文档信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 會向 GitHub 查詢是否有新版本，不會傳送任何文件資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono는 GitHub에서 새 버전이 있는지 확인합니다. 문서에 관한 정보는 전송하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono demande à GitHub si une nouvelle version existe. Aucune information sur vos documents n’est envoyée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono fragt GitHub nach einer neueren Version. Es werden keine Informationen über Ihre Dokumente gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono consulta en GitHub si hay una versión nueva. No se envía información sobre tus documentos."
          }
        }
      }
    },
