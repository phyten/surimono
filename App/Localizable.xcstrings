    "Headings do not break the page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headings do not break the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出しでは改ページしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题不分页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題不分頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목에서 페이지를 나누지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres ne créent pas de saut de page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschriften erzeugen keinen Umbruch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos no saltan de página."
          }
        }
      }
    },
    "Breaks the page before the largest headings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks the page before the largest headings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番大きい見出しの前で改ページします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最大的标题前分页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最大的標題前分頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 제목 앞에서 페이지를 나눕니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut de page avant les plus grands titres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbruch vor den größten Überschriften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta de página antes de los títulos mayores."
          }
        }
      }
    },
    "Adds blank pages so that chapters start on a right-hand page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds blank pages as needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じて白紙を足します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必要时添加空白页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時加入空白頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요하면 빈 페이지를 넣습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des pages blanches si nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt bei Bedarf leere Seiten hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade páginas en blanco si hace falta."
          }
        }
      }
    },
    "Single-sided sheets only break the page before chapters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-sided sheets only break the page before chapters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片面では章の前で改ページするだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单面打印时仅在章前分页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單面列印時僅在章前分頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단면에서는 장 앞에서 페이지만 나눕니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En recto seul, seul un saut de page précède les chapitres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einseitig wird nur vor Kapiteln umbrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A una cara solo se salta de página antes de los capítulos."
          }
        }
      }
    },
