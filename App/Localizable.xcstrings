    "Adds line numbers and a margin for notes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds line numbers and a margin for notes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行番号と書き込みの余白を付けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加行号并留出批注空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加上行號並留出註記空間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 번호와 메모용 여백을 추가합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des numéros de ligne et une marge pour les annotations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Zeilennummern und einen Rand für Notizen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade números de línea y un margen para notas."
          }
        }
      }
    },
    "Sets the text in two columns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the text in two columns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を 2 段に組み直します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将正文排成双栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將內文排成雙欄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문을 2단으로 조판합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispose le texte sur deux colonnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt den Text in zwei Spalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuye el texto en dos columnas."
          }
        }
      }
    },
    "Typeset as the document specifies.": {
      "extractionState": "manual",
      "localizations": {
