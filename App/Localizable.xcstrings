    "The binding changed in the print dialog. Run the duplex test again without changing the binding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The binding changed in the print dialog. Run the duplex test again without changing the binding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷画面で綴じ方が変わりました。綴じ方を変えずに、もう一度両面のテスト印刷をしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bindung wurde im Druckdialog geändert. Wiederhole den Duplex-Test, ohne die Bindung zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La encuadernación cambió en el diálogo de impresión. Repite la prueba a doble cara sin cambiarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reliure a été modifiée dans la boîte de dialogue d’impression. Relancez le test recto verso sans changer la reliure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
