    },
    "Choose a printer to remember its settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a printer to remember its settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターを選ぶと、その設定を覚えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Drucker, um seine Einstellungen zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una impresora para guardar sus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une imprimante pour mémoriser ses réglages."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터를 선택하면 해당 설정을 기억합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择打印机以记住其设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇印表機以記住其設定。"
          }
        }
      }
    },
    "Remembered for %@. Last Sheet First keeps face-up sheets in page order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for %@. Last Sheet First keeps face-up sheets in page order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の設定として覚えます。印刷面を上にして出すプリンターは「最後の用紙から」でページ順に重なります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %@ 记住。面朝上出纸时，“从最后一张开始”可按页序叠放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已為 %@ 記住。面朝上出紙時，「從最後一張開始」可按頁序疊放。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 설정으로 기억합니다. 인쇄면이 위로 나오는 프린터는 ‘마지막 용지부터’로 페이지 순서대로 쌓입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé pour %@. Dernière feuille d’abord garde l’ordre des pages pour une sortie face vers le haut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ gemerkt. Letztes Blatt zuerst hält Blätter mit der Schrift nach oben in Seitenreihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado para %@. Última hoja primero mantiene el orden con salida boca arriba."
          }
        }
      }
    },
    "Remembered for %@ with long-edge binding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for %@ with long-edge binding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で、長辺とじのときの設定として覚えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für %@ bei Bindung an der langen Kante gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda para %@ con encuadernación por el borde largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé pour %@ avec une reliure sur le bord long."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 긴 쪽 제본을 사용할 때의 설정으로 기억합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住 %@ 使用长边装订时的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住 %@ 使用長邊裝訂時的設定。"
          }
        }
      }
    },
    "Remembered for %@ with short-edge binding.": {
      "extractionState": "manual",
