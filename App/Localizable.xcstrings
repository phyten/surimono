    "Press a key combination. Escape cancels; Tab moves focus; Delete clears.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a key combination. Escape cancels; Tab moves focus; Delete clears."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの組み合わせを押して記録します。Escape で中止、Tab で次の項目へ移動、Delete で解除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下组合键。Escape 取消，Tab 移动焦点，Delete 清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下組合鍵。Escape 取消，Tab 移動焦點，Delete 清除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 조합을 누르세요. Escape는 취소, Tab은 포커스 이동, Delete는 해제합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une combinaison. Échap annule, Tab déplace le focus et Suppr efface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke eine Tastenkombination. Escape bricht ab, Tab wechselt den Fokus, Delete löscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una combinación. Escape cancela, Tab mueve el foco y Suprimir borra."
          }
        }
      }
    },
