        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono가 실행 중이면 다른 앱이 앞에 있어도 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces raccourcis fonctionnent tant que Surimono est ouvert, même si une autre app est au premier plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
