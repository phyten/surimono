    "These note page lines do not fit on the page. Reduce the margin or the spacing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These note page lines do not fit on the page. Reduce the margin or the spacing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このノートの線はページに収まりません。線の外の余白か間隔を小さくしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些笔记页线条放不下。请减小线条外边距或间距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些筆記頁線條放不下。請減少線條外邊界或間距。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노트 페이지의 선이 페이지에 들어가지 않습니다. 선 바깥 여백이나 간격을 줄이세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces lignes ne tiennent pas sur la page. Réduisez la marge ou l’espacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Linien passen nicht auf die Seite. Verringern Sie Rand oder Abstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas líneas no caben en la página. Reduce el margen o el espaciado."
          }
        }
      }
    },
