    "The data as it was read is kept aside the first time you save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data as it was read is kept aside the first time you save."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだときのデータは次に保存するときに消さずに別に残します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次保存时，会把读取时的原始数据另行保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次儲存時，會把讀取時的原始資料另行保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 저장할 때 읽어 들인 원래 데이터를 따로 보관합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données telles qu’elles ont été lues sont mises de côté lors du prochain enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten, wie sie gelesen wurden, werden beim nächsten Sichern beiseitegelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos tal como se leyeron se apartan la próxima vez que guardes."
          }
        }
      }
    },
    "This arrangement was changed elsewhere while you edited it. Duplicate keeps your changes as a new arrangement.": {
      "extractionState": "manual",
      "localizations": {
