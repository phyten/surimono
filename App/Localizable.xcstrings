    "Prints **three pages on the left of %@ portrait**, single-sided, with ruled notes on the right.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 縦の左側に3ページ**を片面で印刷し、右側に罫線入りのメモ欄を設けます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prints **three pages on the left of %@ portrait**, single-sided, with ruled notes on the right."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 纵向纸张左侧打印三页**，单面，右侧为横线笔记区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@ 直向紙張左側列印三頁**，單面，右側為橫線筆記區。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 세로 용지 왼쪽에 세 페이지**를 단면 프린트하며 오른쪽에는 줄이 있는 메모 공간을 둡니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **trois pages à gauche sur du %@ portrait**, en recto, avec des lignes pour les notes à droite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt **drei Seiten links auf %@ hoch**, einseitig, mit linierten Notizen rechts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime **tres páginas a la izquierda en %@ vertical**, a una cara, con notas pautadas a la derecha."
          }
        }
      }
    },
