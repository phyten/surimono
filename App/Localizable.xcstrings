    "This document does not say where contents go. To add them, choose “Add Contents to Front”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document does not say where contents go. To add them, choose “Add Contents to Front”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書には、目次を入れる場所の指定がありません。追加するには「先頭に目次を追加」を選んでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档未指定目录的位置。要添加，请选择“在开头添加目录”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件未指定目錄的位置。要加入，請選擇「在開頭加入目錄」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서에는 목차를 넣을 위치가 지정되어 있지 않습니다. 추가하려면 ‘맨 앞에 목차 추가’를 선택하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document n’indique pas où placer le sommaire. Pour l’ajouter, choisissez « Ajouter le sommaire au début »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument legt keine Stelle für den Inhalt fest. Wählen Sie dafür „Inhalt vorn hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no indica dónde va el índice. Para añadirlo, elige «Añadir el índice al principio»."
          }
        }
      }
    },
    "Adds pages of contents in front, with or without a [TOC] in the text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds pages of contents in front, with or without a [TOC] in the text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文に [TOC] がなくても、先頭に目次のページを足します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论文稿有无 [TOC]，都在开头添加目录页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論文件有無 [TOC]，都在開頭加入目錄頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문의 [TOC] 유무와 관계없이 앞에 목차 페이지를 넣습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des pages de sommaire au début, avec ou sans [TOC] dans le texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt vorne Inhaltsseiten ein, mit oder ohne [TOC] im Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade páginas de índice al inicio, con o sin [TOC] en el texto."
          }
        }
      }
    },
