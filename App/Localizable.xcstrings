    "Shows the chapter you are reading; opens Contents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the chapter you are reading; opens Contents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んでいる章を出します。押すと目次が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示正在阅读的章节；点击打开目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示正在閱讀的章節；按一下打開目錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽고 있는 장을 표시하며 목차를 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le chapitre en cours et ouvre la table des matières."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt das aktuelle Kapitel und öffnet das Inhaltsverzeichnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el capítulo que está leyendo y abre el índice."
          }
        }
      }
    },
