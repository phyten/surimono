    "Try landscape paper or smaller text, or adjust this element in the source document.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try landscape paper or smaller text, or adjust this element in the source document."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用紙を横向きにするか文字を小さくするか、元の文書でこの部分を調整してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie Querformat oder kleinere Schrift, oder passen Sie dieses Element im Quelldokument an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con orientación horizontal o texto más pequeño, o ajusta este elemento en el documento original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez le format paysage ou un texte plus petit, ou ajustez cet élément dans le document source."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용지를 가로로 바꾸거나 글자를 줄이거나 원본 문서에서 이 부분을 조정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
