    "The document could not be paginated. Try reloading it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書をページに分割できませんでした。再読み込みしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document could not be paginated. Try reloading it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为文档分页。请尝试重新载入。"
