    "Automatic updates are installed when you quit and are ready the next time you open Surimono.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic updates are installed when you quit and are ready the next time you open Surimono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動アップデートは終了時にインストールされ、次の起動から新しい版になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新会在退出时安装，下次打开 Surimono 时即可使用新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新會在結束時安裝，下次打開 Surimono 時即可使用新版本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 업데이트는 종료할 때 설치되며 다음 실행부터 새 버전을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour automatiques sont installées à la fermeture et disponibles au prochain lancement de Surimono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Updates werden beim Beenden installiert und sind beim nächsten Start von Surimono verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones automáticas se instalan al salir y están listas la próxima vez que abras Surimono."
          }
        }
      }
    },
