    "Turn the sheet along its long edge. The back arrow should point up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the sheet along its long edge. The back arrow should point up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長辺でめくって、裏の矢印が上を向いていれば正しい向きです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende das Blatt an der langen Kante. Der Pfeil auf der Rückseite sollte nach oben zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da la vuelta a la hoja por el borde largo. La flecha del reverso debe apuntar hacia arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retournez la feuille sur son bord long. La flèche au verso doit pointer vers le haut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 쪽으로 넘겼을 때 뒷면 화살표가 위를 향하면 올바른 방향입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿长边翻页，背面箭头朝上即为正确方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿長邊翻頁，背面箭頭朝上即為正確方向。"
          }
        }
      }
    },
    "Turn the sheet along its short edge. The back arrow should point up.": {
