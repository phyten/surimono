    "With One Page, the window narrows to the first page while a spread shows it alone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With One Page, the window narrows to the first page while a spread shows it alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「1ページ分」にすると、見開きで最初のページを単独で表示している間は、ウィンドウを1ページ分の幅にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“一页”时，跨页单独显示第一页期间，窗口会收窄到一页宽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「一頁」時，跨頁單獨顯示第一頁期間，視窗會縮到一頁寬。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘한 페이지’를 선택하면 펼침면에서 첫 페이지를 단독 표시하는 동안 창이 한 페이지 폭으로 좁아집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Une page, la fenêtre se réduit à la première page tant qu’une double page l’affiche seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Eine Seite“ wird das Fenster auf die erste Seite verkleinert, solange die Doppelseite sie einzeln zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Una página, la ventana se estrecha a la primera página mientras la doble página la muestra sola."
          }
        }
      }
    },
