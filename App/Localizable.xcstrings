    "The arrangement in use could not be found, so Standard is used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arrangement in use could not be found, so Standard is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中の配置が見つからないため、標準を使っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到正在使用的排列，因此使用标准排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到正在使用的排列，因此使用標準排列。"
