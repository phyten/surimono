            "value": "Die Dokumente bleiben bis zum erneuten Öffnen oder Löschen auf diesem Mac, höchstens 7 Tage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan en este Mac hasta que vuelvas a abrirlos o los borres, durante un máximo de 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents sont conservés sur ce Mac jusqu’à leur réouverture ou leur effacement, pendant 7 jours au maximum."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 열거나 지울 때까지 이 Mac에 최대 7일간 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档会保存在这台 Mac 上，直到重新打开或清除，最长保留 7 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件會儲存在這部 Mac 上，直到重新打開或清除，最長保留 7 天。"
          }
        }
      }
    },
