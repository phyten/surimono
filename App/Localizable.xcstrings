    "With paper focus; page turns depend on reading direction, zoom and scrolling.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With paper focus; page turns depend on reading direction, zoom and scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙面にフォーカスがあるとき。ページ送りは読む向き・拡大率・スクロール方法に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸面获得焦点时；翻页取决于阅读方向、缩放和滚动方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紙面取得焦點時；翻頁取決於閱讀方向、縮放與捲動方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이에 포커스가 있을 때 읽기 방향, 확대 및 스크롤 방식에 따라 페이지를 넘깁니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le papier a le focus ; le sens de lecture, le zoom et le défilement déterminent les changements de page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
