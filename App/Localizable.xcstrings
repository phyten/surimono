    "Check that the image is readable and in a supported format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the image is readable and in a supported format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を開けることと、対応する形式であることを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie, ob das Bild lesbar ist und ein unterstütztes Format hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la imagen se pueda leer y tenga un formato compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l’image est lisible et dans un format pris en charge."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 읽을 수 있는지, 지원하는 형식인지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
