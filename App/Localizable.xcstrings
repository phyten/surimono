    "This printer cannot print both sides automatically. Print sends the fronts first, then the backs after you reload the paper.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer cannot print both sides automatically. Print sends the fronts first, then the backs after you reload the paper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリンターは自動で両面に印刷できません。「印刷」で表を先に印刷し、用紙を戻してから裏を印刷します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此打印机无法自动双面打印。点按“打印”先打印正面，放回纸张后再打印背面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此印表機無法自動雙面列印。按下「列印」先列印正面，放回紙張後再列印背面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프린터는 자동 양면 인쇄를 지원하지 않습니다. 인쇄를 누르면 앞면을 먼저 인쇄하고 용지를 다시 넣은 후 뒷면을 인쇄합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette imprimante ne permet pas le recto verso automatique. Imprimer envoie les rectos, puis les versos après avoir remis le papier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Drucker kann nicht automatisch beidseitig drucken. Drucken sendet zuerst die Vorderseiten und nach dem Einlegen des Papiers die Rückseiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no permite imprimir a doble cara automáticamente. Imprimir envía primero los anversos y, tras volver a cargar el papel, los reversos."
          }
        }
      }
    },
    "No automatic 2-sided printing. Print sends the fronts, then the backs.": {
      "comment": "Shown under the print summary, where it must fit in two short lines; the full sentence is the Print button's help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No automatic 2-sided printing. Print sends the fronts, then the backs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では両面に印刷できません。「印刷」で表を印刷し、用紙を戻して裏を印刷します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动双面打印。“打印”先打印正面，放回纸张后再打印背面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法自動雙面列印。「列印」先列印正面，放回紙張後再列印背面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 양면 인쇄 불가. 앞면 인쇄 후 용지를 다시 넣어 뒷면을 인쇄합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de recto verso automatique. Imprimer envoie les rectos, puis les versos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein automatischer Duplexdruck. Drucken sendet erst die Vorderseiten, dann die Rückseiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin doble cara automática. Imprimir envía los anversos y luego los reversos."
          }
        }
      }
    },
