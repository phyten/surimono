    "Part of the document is nested too deeply and will not be printed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れ子が深すぎる部分は、省いて印刷します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the document is nested too deeply and will be left out when printing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Dokuments ist zu tief verschachtelt und wird beim Drucken weggelassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del documento tiene demasiados niveles de anidamiento y se omitirá al imprimir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du document comporte trop de niveaux d’imbrication et sera omise à l’impression."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 깊게 중첩된 부분은 제외하고 인쇄합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档的部分内容嵌套过深，打印时将省略这部分内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件的部分內容巢狀層級過深，列印時將略過這部分內容。"
          }
        }
      }
    },
    "Part of the document is nested too deeply. The original text of that part will be printed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れ子が深すぎる部分は、原文のまま印刷します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the document is nested too deeply. The original text of that part will be printed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Dokuments ist zu tief verschachtelt. Für diesen Teil wird der Originaltext gedruckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del documento tiene demasiados niveles de anidamiento. Se imprimirá el texto original de esa parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du document comporte trop de niveaux d’imbrication. Le texte original de cette partie sera imprimé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 일부가 너무 깊게 중첩되어 읽을 수 없습니다. 해당 부분은 원문 그대로 인쇄됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档的部分内容嵌套过深，无法读取，将打印这部分的原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件的部分內容因巢狀層級過深而無法讀取，將列印這部分的原文。"
          }
        }
      }
    },
    "Vertical writing is not supported yet. Showing it horizontally.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦書きには未対応なので、横書きで表示しています"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertical writing is not supported yet. Showing it horizontally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持竖排，已改为横排显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚未支援直排，已改為橫排顯示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 세로쓰기를 지원하지 않아 가로쓰기로 표시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écriture verticale n’est pas encore prise en charge. Le texte s’affiche à l’horizontale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertikaler Text wird noch nicht unterstützt und wird horizontal angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura vertical aún no es compatible. El texto se muestra en horizontal."
