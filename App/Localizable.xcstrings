    "The table of contents is too large, so part or all of it will be left out when printing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table of contents is too large, so part or all of it will be left out when printing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目次は大きすぎるため、一部または全部を省いて印刷します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table des matières est trop volumineuse et sera omise en partie ou en totalité à l’impression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Inhaltsverzeichnis ist zu groß und wird beim Drucken teilweise oder ganz weggelassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice es demasiado grande y se omitirá en parte o por completo al imprimir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목차가 너무 커서 일부 또는 전체를 제외하고 인쇄합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
