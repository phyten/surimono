            "value": "These work while Surimono is running, even when another app is in front."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono の起動中はほかのアプリが前面でも使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 运行时，即使其他应用在前台也可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono 執行時，即使其他 App 在最前方也能使用。"
