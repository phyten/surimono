    "Loading or pagination timed out. Try reloading the document.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みまたはページ分割がタイムアウトしました。文書を再読み込みしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading or pagination timed out. Try reloading the document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
