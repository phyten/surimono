    "“…” is fixed. All operations are also available here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“…” is fixed. All operations are also available here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「…」は動かせません。すべての操作はここからも使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“…”是固定的。所有操作也都可以从这里使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「…」是固定的。所有操作也都可以從這裡使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“…”는 고정되어 있습니다. 모든 작업은 여기서도 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« … » est fixe. Toutes les opérations y sont aussi accessibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„…“ ist fest. Alle Aktionen sind auch hier verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«…» es fijo. Todas las operaciones también están disponibles aquí."
