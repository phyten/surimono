{
  "sourceLanguage": "en",
  "strings": {
    "Export PDF with Surimono": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export PDF with Surimono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono で PDF を書き出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Surimono 导出 PDF"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Surimono 輸出 PDF"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono로 PDF 내보내기"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter un PDF avec Surimono"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF mit Surimono exportieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar PDF con Surimono"
          }
        }
      }
    },
    "Lays a file out on paper with one of Surimono's print layouts and styles, and returns the PDF. The file itself is not changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lays a file out on paper with one of Surimono's print layouts and styles, and returns the PDF. The file itself is not changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを Surimono の印刷レイアウトとスタイルで用紙に並べ、PDF を返します。元のファイルは変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Surimono 的打印布局和样式将文件排到纸张上，并返回 PDF。不会更改文件本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 Surimono 的列印佈局和樣式將檔案排到紙張上，並傳回 PDF。不會更改檔案本身。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono의 프린트 레이아웃과 스타일로 파일을 용지에 배치하고 PDF를 반환합니다. 파일 자체는 변경하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met un fichier en page sur papier avec une disposition d’impression et un style de Surimono, et renvoie le PDF. Le fichier lui-même n’est pas modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt eine Datei mit einem Drucklayout und Stil von Surimono auf Papier und gibt das PDF zurück. Die Datei selbst wird nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compone un archivo sobre papel con un diseño de impresión y un estilo de Surimono, y devuelve el PDF. El archivo en sí no se modifica."
          }
        }
      }
    },
    "Open in Surimono's Print Mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Surimono's Print Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono の印刷モードで開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Surimono 的打印模式中打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Surimono 的列印模式中打開"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono의 프린트 모드에서 열기"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir dans le mode d’impression de Surimono"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Druckmodus von Surimono öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir en el modo de impresión de Surimono"
          }
        }
      }
    },
    "Opens files in Surimono's print mode, with the sheets laid out and ready to print. Nothing is sent to the printer until you press Print.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens files in Surimono's print mode, with the sheets laid out and ready to print. Nothing is sent to the printer until you press Print."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを Surimono の印刷モードで開き、刷る用紙を並べます。「印刷」を押すまで、プリンターには何も送りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Surimono 的打印模式中打开文件，并排好待打印的纸张。在你按下“打印”之前，不会向打印机发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Surimono 的列印模式中打開檔案，並排好待列印的紙張。在你按下「列印」之前，不會向印表機傳送任何內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono의 프린트 모드에서 파일을 열고 프린트할 용지를 배치합니다. ‘프린트’를 누르기 전에는 프린터로 아무것도 보내지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre des fichiers dans le mode d’impression de Surimono, les feuilles mises en page et prêtes à imprimer. Rien n’est envoyé à l’imprimante tant que vous n’appuyez pas sur Imprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Dateien im Druckmodus von Surimono, mit fertig angeordneten Bögen. Es wird nichts an den Drucker gesendet, bis du „Drucken“ drückst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre archivos en el modo de impresión de Surimono, con las hojas compuestas y listas para imprimir. No se envía nada a la impresora hasta que pulses Imprimir."
          }
        }
      }
    },
