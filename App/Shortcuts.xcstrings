    "There is no style named “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no style named “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」という名前のスタイルはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有名为“%@”的样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有名為「%@」的樣式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’(이)라는 이름의 스타일이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun style ne s’appelle « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keinen Stil mit dem Namen „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún estilo llamado «%@»."
          }
        }
      }
    },
    "“%@” is not a file Surimono can export as a PDF.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a file Surimono can export as a PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は、Surimono が PDF として書き出せるファイルではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 Surimono 可以导出为 PDF 的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是 Surimono 可以輸出為 PDF 的檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) Surimono가 PDF로 내보낼 수 있는 파일이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un fichier que Surimono peut exporter au format PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist keine Datei, die Surimono als PDF exportieren kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un archivo que Surimono pueda exportar como PDF."
          }
        }
      }
    },
    "There are no files Surimono can open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no files Surimono can open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono で開けるファイルがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 Surimono 可以打开的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 Surimono 可以打開的檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Surimono에서 열 수 있는 파일이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier que Surimono puisse ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Dateien, die Surimono öffnen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay archivos que Surimono pueda abrir."
          }
        }
      }
    },
