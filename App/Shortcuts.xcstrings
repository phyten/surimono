    "Leave empty to use the default in Surimono's settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to use the default in Surimono's settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のままにすると、Surimono の設定の既定を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则使用 Surimono 设置中的默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則使用 Surimono 設定中的預設值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 Surimono 설정의 기본값을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser le réglage par défaut de Surimono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um die Standardeinstellung von Surimono zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar el valor predeterminado de los ajustes de Surimono."
          }
        }
      }
    },
