PRODUCT_NAME = Surimono
PRODUCT_BUNDLE_IDENTIFIER = io.github.phyten.Surimono
INFOPLIST_FILE = Configs/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 phyten. MIT License.
CODE_SIGN_ENTITLEMENTS = Configs/Surimono.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
ENABLE_PREVIEWS = YES
ENABLE_APP_SANDBOX = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
