PRODUCT_NAME = Surimono
PRODUCT_BUNDLE_IDENTIFIER = io.github.phyten.Surimono
INFOPLIST_FILE = Configs/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 phyten. MIT License.
CODE_SIGN_ENTITLEMENTS = Configs/Surimono.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
ENABLE_PREVIEWS = YES
ENABLE_APP_SANDBOX = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// A development build is a separate app: its own bundle identifier keeps its preferences apart from the installed
// release's, and its name and icon tell the two apart. PRODUCT_NAME stays Surimono because the Makefile and the tests'
// TEST_HOST refer to Surimono.app.
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = io.github.phyten.Surimono.debug
ASSETCATALOG_COMPILER_APPICON_NAME[config=Debug] = AppIcon-Dev
// The Dock and the app switcher show the display name. The menu bar shows CFBundleName, which the generated Info.plist
// always sets to PRODUCT_NAME, so it still reads Surimono. The unconditional value is needed: with only the Debug one,
// a release build's generated Info.plist gets an empty CFBundleDisplayName.
INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_NAME)
INFOPLIST_KEY_CFBundleDisplayName[config=Debug] = Surimono Dev

// Release builds look for updates in the appcast attached to the latest GitHub release ("//" starts a comment in an
// xcconfig, hence "$()"). Debug builds name no feed, so Surimono Dev never replaces itself with the release.
SURIMONO_UPDATE_FEED_URL = https:/$()/github.com/phyten/surimono/releases/latest/download/appcast.xml
SURIMONO_UPDATE_FEED_URL[config=Debug] =
