PRODUCT_NAME = SurimonoQuickLook
PRODUCT_BUNDLE_IDENTIFIER = app.surimono.Surimono.QuickLook
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = app.surimono.Surimono.debug.QuickLook
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Configs/QuickLook-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Surimono Quick Look
INFOPLIST_KEY_CFBundleDisplayName[config=Debug] = Surimono Dev Quick Look
CODE_SIGN_ENTITLEMENTS = Configs/QuickLook.entitlements
ENABLE_APP_SANDBOX = YES
APPLICATION_EXTENSION_API_ONLY = YES
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
