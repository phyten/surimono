<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store requires the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Documents the user opens or drops, and the PDF files the user saves with Export as PDF. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Folders the user allows, kept as security-scoped bookmarks so that images next to a document keep loading. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- Only for resources a document itself refers to, such as images in an HTML page. There is no telemetry. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
